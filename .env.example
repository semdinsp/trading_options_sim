# Copy to .env and fill in real values for local development.
# .env itself is gitignored — never commit real secrets.
#
# Each var needs `export` (not just VAR=value) so `source .env` actually
# passes it through to a subsequently-started process — same convention
# trading_live/trading_system use — e.g.:
#
#   source .env; iex --name trading_options_sim@Scotts-Mac-mini.local -S mix phx.server

# HTTP port — see config/dev.exs, defaults to 4008 (the next free slot
# after sibling apps' 4000-4007 range) if unset.
PORT=4008
export PORT

# trading_system Strategy API (see OPTIONS_SIM_ARCHITECTURE_PLAN.md §4)
TRADING_SYSTEM_API_BASE_URL=http://localhost:4005
export TRADING_SYSTEM_API_BASE_URL

TRADING_SYSTEM_API_TOKEN=
export TRADING_SYSTEM_API_TOKEN

# trading_options_sim's own API/MCP tokens (see §4a) are issued and
# managed at runtime via the /settings page, not set here.
